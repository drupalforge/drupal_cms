{#
/**
 * @file
 * Inline SVG icons.
 *
 * Stroked icons inherit their colour from CSS (`stroke: currentColor`) so they
 * can follow the per-event accent; filled icons take `fill: currentColor`.
 */
#}
{% set size = size|default(22) %}
{% set a11y = label ? {'role': 'img', 'aria-label': label} : {'aria-hidden': 'true', 'focusable': 'false'} %}
{% set stroked = {
  'stroke': 'currentColor',
  'stroke-width': '2',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'fill': 'none',
} %}

{% if name == 'calendar' %}
  <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" {{ create_attribute(stroked|merge(a11y)) }}>
    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
    <path d="M16 2v4M8 2v4M3 10h18"></path>
  </svg>

{% elseif name == 'clock' %}
  <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" {{ create_attribute(stroked|merge(a11y)) }}>
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M12 7v5l3 2"></path>
  </svg>

{% elseif name == 'pin' %}
  <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" {{ create_attribute(stroked|merge(a11y)) }}>
    <path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11z"></path>
    <circle cx="12" cy="10" r="2.5"></circle>
  </svg>

{% elseif name == 'tag' %}
  <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" {{ create_attribute(stroked|merge(a11y)) }}>
    <path d="M3 12V5a2 2 0 0 1 2-2h7l9 9-9 9-9-9z"></path>
    <circle cx="8" cy="8" r="1.5"></circle>
  </svg>

{% elseif name == 'envelope' %}
  <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" {{ create_attribute(stroked|merge(a11y)) }}>
    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
    <path d="M3 7l9 6 9-6"></path>
  </svg>

{% elseif name == 'youtube' %}
  <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" {{ create_attribute(a11y) }}>
    <path d="M23 7.5a3 3 0 0 0-2.1-2.1C19 5 12 5 12 5s-7 0-8.9.4A3 3 0 0 0 1 7.5 31 31 0 0 0 .6 12 31 31 0 0 0 1 16.5a3 3 0 0 0 2.1 2.1C5 19 12 19 12 19s7 0 8.9-.4a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23.4 12 31 31 0 0 0 23 7.5zM9.8 15.3V8.7l5.7 3.3z"></path>
  </svg>

{% elseif name == 'youtube_button' %}
  {# The white plate with a red triangle used on the "Watch all on YouTube" button. #}
  <svg width="22" height="16" viewBox="0 0 24 17" fill="#fff" {{ create_attribute(a11y) }}>
    <rect width="24" height="17" rx="5"></rect>
    <path d="M9.6 4.6l6 3.9-6 3.9z" fill="#E33A2E"></path>
  </svg>

{% elseif name == 'mastodon' %}
  <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" {{ create_attribute(a11y) }}>
    <path d="M21.6 8.3c0-3.7-2.4-4.8-2.4-4.8C17.9 2.9 15.9 2.6 13.8 2.6h-.1c-2.1 0-4.1.3-5.4.9 0 0-2.4 1.1-2.4 4.8 0 .9 0 1.9.1 2.9.2 3.4.8 6.7 4 7.6 1.5.4 2.8.5 3.8.4 1.8-.1 2.8-.6 2.8-.6l-.1-1.3s-1.3.4-2.8.4c-1.5 0-3-.1-3.3-1.9 0-.2 0-.3-.1-.5 0 0 1.4.4 3.3.4 1.1 0 2.1-.1 3.2-.2 2.1-.3 3.9-1.6 4.2-2.8.4-1.9.3-4.8.3-4.8zm-3.3 5.5h-2v-5c0-1-.5-1.6-1.4-1.6-1 0-1.5.7-1.5 1.9v2.8h-2V9.1c0-1.2-.5-1.9-1.5-1.9-.9 0-1.4.6-1.4 1.6v5h-2V8.7c0-1 .3-1.9.8-2.5.5-.6 1.3-.9 2.2-.9 1 0 1.8.4 2.3 1.2l.5.9.5-.9c.5-.8 1.3-1.2 2.3-1.2.9 0 1.6.3 2.2.9.5.6.8 1.4.8 2.5z"></path>
  </svg>

{% elseif name == 'play' %}
  <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 18 18" fill="currentColor" {{ create_attribute(a11y) }}>
    <path d="M4 3l11 6-11 6z"></path>
  </svg>

{% elseif name == 'play_badge' %}
  <svg class="play-badge" width="58" height="40" viewBox="0 0 58 40" {{ create_attribute(a11y) }}>
    <rect width="58" height="40" rx="11" fill="#E33A2E"></rect>
    <path d="M23 12l15 8-15 8z" fill="#fff"></path>
  </svg>
{% endif %}
