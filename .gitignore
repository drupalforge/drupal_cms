/.devpanel/dumps/
/.easy_encryption/
/.editorconfig
/.gitattributes
/.vscode/
/AGENTS*
/assets/
/config/*
!/config/sync/
!/config/sync/**
/CONTRIBUTING*
/LICENSE*
/logs/*
!/logs/.gitkeep
/packages.json
/patches.lock.json
/private/
/README*
/recipes/
/vendor/
/web/*
!/web/modules/
!/web/modules/custom/
!/web/modules/custom/**
!/web/themes/
!/web/themes/custom/
!/web/themes/custom/**

# Contrib code is installed by Composer, never committed. The rules above
# un-ignore web/modules and web/themes so the custom/ dirs can be tracked,
# which lets the contrib dirs leak through; exclude them explicitly.
/web/modules/contrib/
/web/themes/contrib/
/web/modules/README.txt
/web/themes/README.txt
/web/themes/blank/

# Staging area for the Pantheon migration: database dumps, a full site
# checkout, and design comps. 414 MB, none of it source.
/INCOMING/

# Composer backups taken during the Drupal Forge downgrade.
*.forge.bak
composer.json~

.DS_Store
