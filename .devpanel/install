#!/usr/bin/env php
<?php

/**
 * @file
 * Script to apply required recipes without completing installation.
 *
 * This allows users to experience an interactive installation with less
 * waiting.
 */

use Drupal\Core\Installer\Form\SiteConfigureForm;
use Drupal\drupal_cms_installer\OperationTracker;

$_GET['rewrite'] = 'ok';
$_GET['name'] = '1';
$_GET['template'] = '1';

register_shutdown_function('_install_drupal_cms_profile_modules');

function _install_drupal_cms_profile_modules() {
  global $install_state;
  if (!empty($install_state['base_system_verified'])) {
    // Submit install_configure_form programmatically during the pre-run phase.
    $install_state['forms']['install_configure_form'] = [
      'account' => [
        'mail' => 'admin@example.com',
        // Programmatic installs expect password_confirm-style input.
        'pass' => [
          'pass1' => 'admin',
          'pass2' => 'admin',
        ],
      ],
    ];
    $install_state['interactive'] = FALSE;
    install_get_form(SiteConfigureForm::class, $install_state);
    $batch = install_profile_modules($install_state);
    $batch['operations'] = array_values(\Drupal::service(OperationTracker::class)->prepare($batch['operations']));
    batch_set($batch);
    $batch = &batch_get();
    $batch['progressive'] = FALSE;
    batch_process();

    // The profile locks configuration to the pre-run's language, and the
    // installer theme hides the language switcher while a lock is set. Clear
    // the lock so the user can choose a language. The site template form
    // overwrites it regardless, so leaving it empty has no other effect.
    // @see drupal_cms_installer_install_profile()
    // @see drupal_cms_installer_theme_preprocess_install_page()
    // @see \Drupal\drupal_cms_installer\Form\SiteTemplateForm::submitForm()
    \Drupal::configFactory()
      ->getEditable('config_language_lock.settings')
      ->clear('locked_langcode')
      ->save();

    // Resume after the configure form while allowing earlier tasks marked
    // INSTALL_TASK_RUN_IF_REACHED to run again.
    // @see install_tasks_to_perform()
    \Drupal::state()->set('install_task', 'install_configure_form');
  }
}

chdir(dirname(__DIR__) . '/web/core');
ob_start(fn($buffer, $phase) => TRUE, 1);
include 'install.php';
