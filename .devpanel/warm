#!/usr/bin/env php
<?php

/**
 * @file
 * Warms the Drupal page cache.
 */

use Drupal\Core\DrupalKernel;
use Drupal\Core\PageCache\ChainRequestPolicy;
use Symfony\Component\HttpFoundation\Request;

chdir(dirname(__DIR__) . '/web');
$_SERVER['HTTP_USER_AGENT'] = 'Drupal Forge';
$_SERVER['REQUEST_URI'] = $argv[1] ?? '/';
$_SERVER['REQUEST_METHOD'] = 'GET';
$_SERVER['SCRIPT_NAME'] = '/index.php';
$_SERVER['SCRIPT_FILENAME'] = getcwd() . '/index.php';
$_SERVER['SERVER_NAME'] = getenv('DP_HOSTNAME') ?: 'localhost';
$_SERVER['HTTP_HOST'] = $_SERVER['SERVER_NAME'];
$_SERVER['SERVER_PORT'] = '80';
$_SERVER['HTTPS'] = 'on';

$autoloader = require 'autoload.php';
$request = Request::createFromGlobals();
$kernel = DrupalKernel::createFromRequest($request, $autoloader, 'prod');
$kernel->boot();
$container = $kernel->getContainer();
// Keep the other collected policies, including session and authentication rules.
$rules = new ReflectionProperty(ChainRequestPolicy::class, 'rules');
$original = [];

try {
  foreach (['page_cache_request_policy', 'dynamic_page_cache_request_policy'] as $id) {
    if (!$container->has($id)) {
      continue;
    }
    $policy = $container->get($id);
    $policy_rules = $rules->getValue($policy);
    $original[] = [$policy, $policy_rules];
    $rules->setValue($policy, []);
  }
  $response = $kernel->handle($request);
  $kernel->terminate($request, $response);
}
finally {
  foreach ($original as [$policy, $policy_rules]) {
    $rules->setValue($policy, $policy_rules);
  }
}
echo "Warmed cache for " . $_SERVER['REQUEST_URI'] . "\n";
